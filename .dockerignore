# Docker build context exclusions for build/package/Dockerfile.
#
# The builder stage does `COPY . .` and the runtime stage copies `migrations/`
# and `config/lightstack.yaml` from the context, so NEITHER may be excluded here.
# Everything below is unused by the build and only inflates the context.

# VCS and build output
.git/
.gitignore
bin/
*.exe
*.test
*.out

# Local environment / secrets — must never reach an image layer
.env
.env.*
*.pem
*.key

# Documentation and project-management metadata
docs/
memory/
.specify/
.beastmode/
*.md

# Deployment manifests: rendered outside the image, not built into it
charts/
deployments/

# Editor and OS noise
.idea/
.vscode/
*.swp
*.tmp
.DS_Store
Thumbs.db
