# ==========================================
# Session Configuration
# ==========================================

# Session timeout, 4 hours. Deliberately SHORTER than Lightstack's 24h token_ttl
# (config/lightstack.yaml, charts/lightstack/templates/_helpers.tpl): upstream Horizon
# documents SESSION_TIMEOUT as a way to supersede the token timeout with a shorter session,
# and it never exceeds token expiry. With the default SESSION_REFRESH=True this is an idle
# timeout, not a hard limit. Upstream's own default is 3600.
SESSION_TIMEOUT = 14400

# Session engine (use cache with Memcached for multi-process reliability)
SESSION_ENGINE = 'django.contrib.sessions.backends.cache'

# Security settings (enable in production with HTTPS)
SESSION_COOKIE_SECURE = False  # Set True with HTTPS
SESSION_COOKIE_HTTPONLY = True
SESSION_COOKIE_SAMESITE = 'Lax'
CSRF_COOKIE_SECURE = False     # Set True with HTTPS
# MUST stay False in BOTH copies, and `make horizon-chart-sync` MUST be run after
# changing it: deployments/horizon-config/local_settings is the source that compose
# reads, and charts/horizon/files/local_settings is generated from it and is
# what real mode (Helm) reads. Both paths are named explicitly because this comment is
# copied verbatim into the generated file, where "this file" would mean the other one —
# the drift recorded as F14 is exactly what that ambiguity produced.
#
# Horizon's AngularJS layer takes the CSRF token from document.cookie
# (framework.module.js: xsrfCookieName = 'csrftoken'). HttpOnly hides it from JS, so
# any write on that path goes out with no X-CSRFToken header and Django rejects it.
#
# The effect is SELECTIVE, measured in real mode 2026-07-29 with HttpOnly still True:
#   - POST /api/nova/keypairs/  -> 201  (import and generate both fine)
#   - the launch wizard's POST /api/nova/servers/ -> worked, instance reached ACTIVE
#   - DELETE /api/nova/keypairs/{name} -> Django logged
#     "Forbidden (CSRF token missing.)" and the panel silently did nothing
# So some paths obtain the token another way and some do not; do not assume a given
# control works just because a neighbouring one does. Django itself documents
# HttpOnly on this cookie as offering "no practical protection", and upstream Horizon
# does not set it.
CSRF_COOKIE_HTTPONLY = False
CSRF_COOKIE_SAMESITE = 'Lax'

# ==========================================
# Console Access Configuration
# ==========================================

# Horizon dispatches on this via CONSOLES in
# openstack_dashboard/dashboards/project/instances/console.py, whose keys are
# exactly: AUTO, VNC, SPICE, RDP, SERIAL, MKS.
#
# It was 'novnc' here, which is NOT one of those. CONSOLES['novnc'] raises
# KeyError, Horizon converts that to NotAvailable, and the Console tab reports
# "Console is currently unavailable" WITHOUT ever calling Nova. That masked the
# real console for as long as F1 was open, because the backend was broken too.
# 'VNC' is the value that reaches Nova's noVNC console (SPEC-021 / #534).
CONSOLE_TYPE = 'VNC'

# There is no Horizon setting for the console proxy URL: upstream documents CONSOLE_TYPE only, and
# the URL comes from Nova's os-getVNCConsole / remote-consoles response, which Lightstack builds
# from nova.console_proxy_base_url in lightstack.yaml. NOVNC_PROXY_URL and CONSOLE_TYPES lines
# used to sit here; Horizon reads neither.

