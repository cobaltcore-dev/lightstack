# ==========================================
# Basic Django Settings
# ==========================================

# Both are env-driven so a deployer can change them without editing this file; the compose
# stack and the Helm chart each inject them. Defaults are the safe ones -- upstream Horizon also
# defaults DEBUG to False -- and the dev compose file opts into HORIZON_DEBUG=True.
#
# ALLOWED_HOSTS stays permissive by default on purpose: DEBUG=False makes it mandatory, and the
# chart's documented entry point is http://<node-ip>:30080/dashboard, so pinning a single host
# would make Django answer 400 to every request. Narrow it for anything shared.
DEBUG = os.environ.get('HORIZON_DEBUG', 'False').strip().lower() in ('1', 'true', 'yes', 'on')
_allowed_hosts = [h.strip() for h in os.environ.get('HORIZON_ALLOWED_HOSTS', '*').split(',') if h.strip()]
ALLOWED_HOSTS = _allowed_hosts or ['*']

# SECRET_KEY must be IDENTICAL across all WSGI workers. apache/horizon-nolist.conf runs
# `processes=3`, and Django signs CSRF tokens and the messages cookie with this value, so a
# per-process key means a token minted by one worker is rejected by the others. Computing it
# inline (e.g. os.urandom at import) is therefore wrong here -- upstream Horizon's
# local_settings.py.example says to share one key "regardless of the amount of Python WSGI
# workers".
#
# Prefer an injected value; otherwise fall back to Horizon's own helper, which generates the
# key once under a file lock and shares it between workers — the same approach upstream's
# local_settings.py.example uses ("regardless of the amount of Python WSGI workers").
# In the kolla image the env var is the ONLY reliable mechanism: extend_start.sh imports these
# settings as root (collectstatic/compress), while apache's WSGIDaemonProcess runs as `horizon`,
# so the key file the first importer creates is root-owned 0600 and the workers get an unhandled
# PermissionError on read -- generate_or_read_from_file() has no except clause, so Horizon fails
# to start. (kolla chowns its OWN default key store to `horizon` at the end of extend_start.sh,
# but that fix does not cover this path.) All three deployments therefore inject SECRET_KEY:
# docker-compose-horizon.yml, the horizon-chart Deployment, and scripts/deploy-turnkey.sh. The
# file fallback is kept for running Horizon outside those deployments, where a single user owns
# the whole process tree; point it elsewhere with HORIZON_SECRET_KEY_FILE.
_secret_key = os.environ.get('SECRET_KEY')
if not _secret_key:
    from horizon.utils import secret_key as _secret_key_utils
    _secret_key = _secret_key_utils.generate_or_read_from_file(
        os.environ.get('HORIZON_SECRET_KEY_FILE', '/tmp/.horizon_secret_key'))
SECRET_KEY = _secret_key

