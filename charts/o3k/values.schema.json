{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "O3K Helm chart values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED container image repository (no default — FR-018)."
        },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array" }
      }
    },
    "deploymentMode": { "type": "string", "enum": ["single-node", "multi-node"] },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "database": { "type": "object" },
    "secrets": { "type": "object" },
    "endpointHost": { "type": "string" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] }
      }
    },
    "ingress": { "type": "object" },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "certManagerKind": { "type": "string", "enum": ["ClusterIssuer", "Issuer"] }
      }
    },
    "nova": {
      "type": "object",
      "properties": { "libvirtMode": { "type": "string", "enum": ["stub", "real"] } }
    },
    "neutron": {
      "type": "object",
      "properties": {
        "networkingMode": { "type": "string", "enum": ["stub", "iptables", "ebpf"] },
        "securityGroupMode": { "type": "string", "enum": ["stub", "iptables", "ebpf"] }
      }
    },
    "cinder": { "type": "object" },
    "glance": { "type": "object" },
    "realMode": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "multiNode": { "type": "object" },
    "cache": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "dataRetentionPolicy": { "type": "string", "enum": ["retain", "delete"] },
    "logging": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "format": { "type": "string", "enum": ["json", "text"] }
      }
    }
  }
}
