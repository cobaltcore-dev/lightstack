[Unit]
Description=O3K OpenStack-Compatible Cloud
Documentation=https://github.com/cobaltcore-dev/o3k
After=network-online.target postgresql.service libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=o3k
Group=o3k
EnvironmentFile=-/etc/default/o3k
ExecStart=/usr/local/bin/o3k --config /etc/o3k/o3k.yaml --migrations /etc/o3k/migrations
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/o3k /var/run/o3k

# Resource limits
LimitNOFILE=65536
TasksMax=4096

# Capabilities needed for networking
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
