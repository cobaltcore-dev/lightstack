#!/bin/sh
# Appends a Signed-off-by trailer using the committer's configured name and
# email. Skips if the trailer is already present (e.g. --signoff was passed
# explicitly or a previous amend already added it).
#
# Activate for this repo:
#   git config core.hooksPath .githooks
#
# The CI dco-check job enforces that the email ends in @sap.com, so make sure
# your git user.email is set to your SAP address:
#   git config user.email "firstname.lastname@sap.com"

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"  # message | template | merge | squash | commit

# Don't append to merge commits or fixup/squash commits generated by rebase --autosquash.
case "$COMMIT_SOURCE" in
  merge|squash) exit 0 ;;
esac

NAME=$(git config user.name)
EMAIL=$(git config user.email)

if [ -z "$NAME" ] || [ -z "$EMAIL" ]; then
  echo "prepare-commit-msg: git user.name or user.email not set, skipping sign-off" >&2
  exit 0
fi

TRAILER="Signed-off-by: $NAME <$EMAIL>"

if grep -qF "$TRAILER" "$COMMIT_MSG_FILE"; then
  exit 0
fi

printf "\n%s\n" "$TRAILER" >> "$COMMIT_MSG_FILE"
