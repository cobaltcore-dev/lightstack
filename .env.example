# Lightstack Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# ============================================
# Lightstack Configuration
# ============================================

# JWT secret for token signing (CHANGE THIS IN PRODUCTION!)
LIGHTSTACK_JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32

# Ceph RGW (Swift) compatibility: render the token payload's project id
# (token.project.id) with '-' → '_' in the POST /v3/auth/tokens responses.
# Ceph tenant names accept [A-Za-z0-9_] only (no hyphens). Everything else
# (management APIs, DB, JWT, service catalog) stays canonical. Default: false.
# LIGHTSTACK_KEYSTONE_RGW_COMPAT_TENANT_IDS=false

# Log level: debug, info, warn, error
LIGHTSTACK_LOG_LEVEL=info

# Log format: json, console
LIGHTSTACK_LOG_FORMAT=json

# Host advertised in the Keystone service catalog and resource self-links
LIGHTSTACK_ENDPOINT_HOST=localhost

# Scheme advertised in the service catalog and self-links: http (default) or https.
# Set to https when terminating TLS per service port (SPEC-007 WS-3 / SPEC-008).
LIGHTSTACK_ENDPOINT_SCHEME=http

# ============================================
# Database Configuration
# ============================================

# PostgreSQL credentials. The Compose stacks read these and default to the values below.
# On an upgrade, set them to the identity the existing postgres volume was created with —
# initdb honours them only on an empty data directory (see docs/UPGRADING.md).
POSTGRES_DB=lightstack
POSTGRES_USER=lightstack
POSTGRES_PASSWORD=secret

# Full database URL (auto-constructed if not set)
# LIGHTSTACK_DB_URL=postgres://lightstack:secret@postgres:5432/lightstack?sslmode=disable

# ============================================
# Horizon Configuration
# ============================================

# OpenStack host (use 'lightstack' for Docker Compose, 'host.docker.internal' for local Lightstack)
OPENSTACK_HOST=lightstack

# Debug mode (set to False in production)
DEBUG=True

# Horizon image
# HORIZON_IMAGE=quay.io/openstack.kolla/horizon:2025.1-ubuntu-noble

# ============================================
# Network Configuration (Optional)
# ============================================

# Change these if default ports conflict with existing services

# Horizon ports
# HORIZON_HTTP_PORT=80
# HORIZON_HTTPS_PORT=443

# Lightstack API ports
# KEYSTONE_PORT=5000
# NOVA_PORT=8774
# NEUTRON_PORT=9696
# CINDER_PORT=8776
# GLANCE_PORT=9292
# METADATA_PORT=8775

# PostgreSQL port
# POSTGRES_PORT=5432

# ============================================
# Resource Limits (Optional)
# ============================================

# Uncomment to set resource limits for containers
# LIGHTSTACK_CPU_LIMIT=2
# LIGHTSTACK_MEMORY_LIMIT=4g
# POSTGRES_MEMORY_LIMIT=2g
# HORIZON_MEMORY_LIMIT=2g
