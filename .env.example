# Lightstack Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# ============================================
# Lightstack Configuration
# ============================================

# JWT secret for token signing (CHANGE THIS IN PRODUCTION!)
LIGHTSTACK_JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32

# Ceph RGW (Swift) compatibility: render the token payload's project id
# (token.project.id) in OpenStack's established dash-free form in the
# /v3/auth/tokens responses (password issue, token re-scope and GET validation).
# /v3/s3tokens already uses this historical dash-free form, so enabling the flag
# makes Swift use the same tenant namespace without re-keying existing S3 data.
# Ceph tenant names accept [A-Za-z0-9_] only (no hyphens). Everything else
# (management APIs, DB, JWT, service catalog) stays canonical; clients reading
# token.project.id directly must take canonical ids from the management APIs.
# Default: false.
# LIGHTSTACK_KEYSTONE_RGW_COMPAT_TENANT_IDS=false

# Host advertised in the Keystone service catalog and resource self-links.
# NOTE: binary-level env var, NOT interpolated by any compose file in this
# repository (the stacks hard-code it: 'localhost' in docker-compose.yml,
# 'lightstack' in docker-compose-horizon.yml). Effective when running the
# binary directly; see docs/CONFIGURATION.md.
LIGHTSTACK_ENDPOINT_HOST=localhost

# Scheme advertised in the service catalog and self-links: http (default) or https.
# Binary-level env var (not compose-interpolated); set to https when TLS is
# terminated in front (SPEC-007 WS-3 / SPEC-008).
LIGHTSTACK_ENDPOINT_SCHEME=http

# ============================================
# Database Configuration
# ============================================

# PostgreSQL credentials. The Compose stacks read these and default to the values below.
# On an upgrade, set them to the identity the existing postgres volume was created with —
# initdb honours them only on an empty data directory (see docs/UPGRADING.md).
POSTGRES_DB=lightstack
POSTGRES_USER=lightstack
POSTGRES_PASSWORD=secret

# Full database URL (auto-constructed if not set)
# LIGHTSTACK_DB_URL=postgres://lightstack:secret@postgres:5432/lightstack?sslmode=disable

# ============================================
# Horizon Configuration
# ============================================

# OpenStack host for CLI examples (use 'lightstack' for Docker Compose,
# 'host.docker.internal' for local Lightstack). Consumed by shell snippets in
# the docs, not interpolated by the compose files (the horizon stack's
# local_settings hard-codes OPENSTACK_HOST = "lightstack").
OPENSTACK_HOST=lightstack

# Horizon debug mode — interpolated by docker-compose-horizon.yml
# (HORIZON_DEBUG; local_settings defaults it to False, the dev stack opts in
# so a 500 shows a traceback). Set to False in production.
HORIZON_DEBUG=True

# Horizon image — the horizon compose file hard-codes the image; this
# variable is a note for building/pinning your own override, not something
# the stack interpolates.
# HORIZON_IMAGE=quay.io/openstack.kolla/horizon:2025.1-ubuntu-noble

# ============================================
# Network Configuration (Optional)
# ============================================

# Change these if default ports conflict with existing services

# Horizon ports (the only port the compose files interpolate is HORIZON_HTTP_PORT)
# HORIZON_HTTP_PORT=80

# NOTE: the lightstack binary has no per-service port environment overrides —
# listen ports are configured in lightstack.yaml only.

# ============================================
# Resource Limits (Optional)
# ============================================

# No compose file in this repository interpolates resource-limit variables.
# To cap container resources, use a compose override file in the repo root
# (where the command below runs):
#
#   # docker-compose.override.yml (repo root)
#   services:
#     lightstack:
#       deploy:
#         resources:
#           limits:
#             cpus: "2"
#             memory: 4g
#
# and start with: docker compose -f deployments/docker-compose.yml \
#                     -f docker-compose.override.yml up -d
