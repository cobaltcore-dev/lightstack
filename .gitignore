# Binaries
bin/
# The CLI conformance harness lives in test/cli/bin/ — scripts, not
# binaries; re-include it so the gate scripts ship with the repo.
!test/cli/bin/
*.exe
*.dll
*.so
*.dylib

# Compiled binaries in root
/lightstack
/lightstack-migrate

# Test binary
*.test

# Output of go coverage tool
*.out
coverage.txt

# Dependency directories
vendor/
.tools/

# Go workspace file
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Application
*.log
/var/
/tmp/

# Local config overrides
config/local.yaml
.env
.env.*
!.env.example

# Database
*.db
*.sqlite

# Sensitive files
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/
credentials/

# Claude Code — session-specific (user-local, not shared)
.claude/session-reads.txt
.claude/settings.local.json
.claude/plans/
.claude/worktrees/

# Agent/LLM session artifacts (generated per-session, not project docs)
task_plan.md
notes.md
/output*.md
/SPRINT_SUMMARY*.md
/PROJECT_STATUS.md
/PRE_APPROVAL_CHECKLIST.md
/TEST_COVERAGE_REPORT.md
/validation_results*.txt
*.bak
*.tmp
*.old

# Host-test artifacts (downloaded by docs/specs/*/HOST-TESTING.md, not source)
cirros*.img

# SPEC-018 real-mode host-run values — contains RGW/JWT secrets, never commit.
# HOST_TESTING_REAL_MODE.md generates this (ideally under /tmp); guard the repo-root path too.
/lightstack-real-values.yaml

# Keep important root docs
# Python harness regression tests
__pycache__/

